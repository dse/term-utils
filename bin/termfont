#!/usr/bin/env bash
set -o errexit
set -o pipefail
set -o nounset
shopt -s lastpipe
main () {
    OSC=$'\e'']'
    ST=$'\e'\\
    if (( $# < 1 )) ; then
        >&2 echo "termfont [<font>] [<size>]"
        exit 1
    else
        for i ; do
            if [[ "$i" =~ ^@ ]] ; then
                size "${i#@}"
            elif [[ "$i" =~ ^= ]] ; then
                font "${i#=}"
            elif [[ "$i" =~ ^[0-9]+$ ]] ; then
                size "$i"
            else
                font "$i"
            fi
        done
    fi
}
size () {
    # >&2 echo "setting font size to ${1}"
    echo -n "${OSC}7777;${1}${ST}"
}
font () {
    # >&2 echo "setting font to ${1}"
    echo -n "${OSC}50;${1}${ST}"
}
#------------------------------------------------------------------------------
main "$@"
# https://github.com/mintty/mintty/wiki/CtrlSeqs
# https://invisible-island.net/xterm/ctlseqs/ctlseqs.html
